{
  "name": "dark-reign-theme",
  "displayName": "Dark Reign Themes",
  "description": "Dark Reign themes for VS Code",
  "version": "1.2.0",
  "publisher": "AnasFiguigui",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b1f23",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnasFiguigui/dark-reign-theme"
  },
  "bugs": {
    "url": "https://github.com/AnasFiguigui/dark-reign-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "reign",
    "night",
    "vscode",
    "inferno",
    "void"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Dark Reign",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-default.json"
      },
      {
        "label": "Dark Reign - Void",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-void.json"
      },
      {
        "label": "Dark Reign - Inferno",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-inferno.json"
      },
      {
        "label": "Dark Reign - Emerald",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-emerald.json"
      },
      {
        "label": "Dark Reign - Ocean",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-ocean.json"
      },
      {
        "label": "Dark Reign - Blossom",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-reign-blossom.json"
      }
    ]
  },
  "devDependencies": {
    "nodemon": "^2.0.3",
    "vsce": "^1.100.1"
  },
  "scripts": {
    "start": "nodemon --watch src src/index.js",
    "build": "node src/index.js",
    "package": "npm run build && vsce package -o ./build/dark-reign-theme.vsix"
  }
}
